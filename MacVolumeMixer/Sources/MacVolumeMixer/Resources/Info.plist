<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>MacVolumeMixer</string>
	<key>CFBundleDisplayName</key>
	<string>MacVolumeMixer</string>
	<key>CFBundleIdentifier</key>
	<string>com.adjustvolume.MacVolumeMixer</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleExecutable</key>
	<string>MacVolumeMixer</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<!-- Menu bar agent: no Dock icon, no main window. -->
	<key>LSUIElement</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright. All rights reserved.</string>
	<!--
	  We deliberately do NOT declare NSMicrophoneUsageDescription: this app never
	  touches the microphone. Per-process audio capture/tap (used to re-synthesize
	  a muted app's audio at our own gain) is gated by a system-managed "Audio
	  Recording" / "Screen & System Audio Recording" TCC prompt that macOS shows
	  automatically the first time AudioHardwareCreateProcessTap is called — there
	  is no public Info.plist usage-description key for it (same as Screen
	  Recording). See docs/audio-architecture.md.
	-->
</dict>
</plist>
